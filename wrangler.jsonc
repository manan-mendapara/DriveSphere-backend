
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drivesphere-backend",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  }
}
